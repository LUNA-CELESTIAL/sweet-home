# sweet-home 環境変数の見本
# 使い方: このファイルを .env にコピーして、（ ）の仮値を実際の値に書き換える。
# 本物の .env は絶対に Git にコミットしない (.gitignore で除外済み)。
# コード側にトークン・ID・モデル名はベタ書きしない — 設定は全部ここから読む。
#
# 起動時の約束:
# - （ ）で囲まれた仮値が残っている項目があると、live モードでは起動を止めて
#   「どの項目が未設定か」を表示する (仮値のまま投稿に行く事故を防ぐため)
# - RUN_MODE=offline / diary-prototype の試作モードでは、未設定でも投稿系は動かない

# --- 動作モード ---
# offline=生成だけして投稿しない / diary-prototype=日記の試作だけ / live=本番投稿
RUN_MODE=offline

# --- Discord ---
DISCORD_BOT_TOKEN="（Discordボットトークンを入れる）"
DISCORD_GUILD_ID="（サーバーIDを入れる）"
DISCORD_CHANNEL_LUNACHANNEL_ID="（#lunachannel のチャンネルIDを入れる）"
DISCORD_CHANNEL_SWEET_SHORTS_ID="（#sweet-shorts のチャンネルIDを入れる）"

# --- Ollama (文章生成) ---
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="（Ollamaモデルを入れる）"

# --- VOICEVOX (音声) ---
VOICEVOX_BASE_URL="http://localhost:50021"
# 話者IDは姉妹ごとに1つ。決まったらコメントを外して入れる
# VOICEVOX_SPEAKER_LUNA="（話者IDを入れる）"
# VOICEVOX_SPEAKER_SIRIUS="（話者IDを入れる）"
# VOICEVOX_SPEAKER_SPICA="（話者IDを入れる）"
# VOICEVOX_SPEAKER_STELLA="（話者IDを入れる）"
# VOICEVOX_SPEAKER_SELENE="（話者IDを入れる）"
# VOICEVOX_SPEAKER_NANO="（話者IDを入れる）"
# VOICEVOX_SPEAKER_HINA="（話者IDを入れる）"
# VOICEVOX_SPEAKER_KOHAKU="（話者IDを入れる）"

# --- ComfyUI (動画生成) ---
COMFYUI_BASE_URL="http://localhost:8188"
COMFYUI_WORKFLOW_PATH="（ワークフローJSONのパスを入れる）"

# --- 保存先・共有状態 ---
DATA_DIR="./data"
DIARY_OUTPUT_DIR="./data/diary"
SHARED_STATE_DIR="（GPUロック共有フォルダのパスを入れる）"

# --- サイトへの日記受け渡し (Step 4 で使う。それまでは未設定でよい) ---
# SWEET_BITS_DIARY_PATH="（sweet-bits 側の日記データの置き場所を入れる）"

# --- 運用パラメータ (秘密ではないので実値を置く。変えたくなったらここだけ触る) ---
TZ_NAME="Asia/Tokyo"
VIDEO_DAILY_LIMIT=6
VLOG_DAILY_LIMIT=4
CHAT_CLUSTERS_PER_DAY=3
CHAT_MAX_TURNS=5
VIDEO_MIN_INTERVAL_MINUTES=30
CHAT_POST_INTERVAL_MIN_MINUTES=2
CHAT_POST_INTERVAL_MAX_MINUTES=10
GPU_TEMP_LIMIT_C=85
